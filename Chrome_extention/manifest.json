{
  "manifest_version": 3,
  "name": "Auto Lead Extractor",
  "version": "1.0",

  "permissions": [
    "tabs",
    "activeTab",
    "scripting"

  ],

  "host_permissions": [
    "<all_urls>",
    "https://lead-extractor-8uc5.onrender.com/scrape-url"
  ],

  "background": {
    "service_worker": "background.js" 
  },

  "action": {
    "default_popup": "popup.html"
  }
}